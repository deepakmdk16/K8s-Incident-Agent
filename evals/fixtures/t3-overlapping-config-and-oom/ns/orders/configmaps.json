        "run.sh": "#!/bin/sh\n# orders-report-worker: builds the nightly order export.\nset -eu\necho \"report-worker: loading order history into in-memory export buffer (~150MiB)\"\nEXPORT_BUFFER=\"$(dd if=/dev/zero bs=1M count=150 2>/dev/null | tr '\\000' 'x')\"\necho \"report-worker: export buffer ready (${#EXPORT_BUFFER} bytes); nightly export served from memory\"\nwhile :; do\n  echo \"report-worker: idle; next export window 00:30 UTC\"\n  sleep 60\ndone\n"
      },
