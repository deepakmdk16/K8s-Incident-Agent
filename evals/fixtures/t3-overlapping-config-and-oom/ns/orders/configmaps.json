        "run.sh": "#!/bin/sh\n# orders-audit: writes the order audit trail.\nset -eu\n: \"${DATABASE_URL:?DATABASE_URL is required}\"\nDB_HOST=\"${DATABASE_URL#*@}\"; DB_HOST=\"${DB_HOST%%:*}\"\necho \"audit: config ok - database_url resolved from orders-config (host=${DB_HOST})\"\nwhile :; do\n  echo \"audit: trail writer heartbeat\"\n  sleep 60\ndone\n"
      },
