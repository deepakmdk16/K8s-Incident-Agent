    {
      "apiVersion": "v1",
      "data": {
        "run.sh": "#!/bin/sh\nset -u\necho \"billing-api: serving on :8080\"\nwhile true; do echo \"billing-api: heartbeat\"; sleep 30; done\n",
        "wait-for-db.sh": "#!/bin/sh\nset -u\necho \"wait-for-db: waiting for ${DB_HOST}:5432 before starting billing-api\"\nuntil nc -z -w 2 \"$DB_HOST\" 5432 2>/dev/null; do\n  echo \"waiting for ${DB_HOST}:5432\"\n  sleep 5\ndone\necho \"wait-for-db: ${DB_HOST}:5432 reachable\"\n"
      },
