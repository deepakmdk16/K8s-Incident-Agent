      "data": {
        "run.sh": "#!/bin/sh\nset -u\necho \"gateway: starting catalog poller\"\nwhile true; do\n  if wget -T 3 -q -O /dev/null http://catalog.shop.svc.cluster.local:8080/ 2>/dev/null; then\n    echo \"gateway: catalog fetch ok\"\n  else\n    echo \"gateway: catalog fetch FAILED (timeout or connection refused)\"\n  fi\n  sleep 5\ndone\n"
      },
