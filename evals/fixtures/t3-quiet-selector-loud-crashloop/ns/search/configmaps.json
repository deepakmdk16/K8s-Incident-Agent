    {
      "apiVersion": "v1",
      "data": {
        "run.sh": "#!/bin/sh\nset -u\necho \"gateway: starting search poller\"\nwhile true; do\n  if wget -T 3 -q -O /dev/null http://search.search.svc.cluster.local:8080/ 2>/dev/null; then\n    echo \"gateway: search fetch ok\"\n  else\n    echo \"gateway: search fetch FAILED (timeout or connection refused)\"\n  fi\n  sleep 5\ndone\n"
      },
